serenity {
  take.screenshots = FOR_FAILURES
  restart.browser.for.each = NEVER
  project.name = "Demoblaze E2E - Serenity BDD Screenplay"
  use.unique.browser = false
  batch.strategy = FEATURE
}

webdriver {
  driver = chrome
  autodownload = true
  capabilities {
    browserName = "chrome"
    "goog:chromeOptions" {
      args = ["--start-maximized", "--disable-notifications",
              "--disable-popup-blocking", "--no-sandbox",
              "--disable-dev-shm-usage", "--remote-allow-origins=*"]
    }
  }
}

headless.mode = false

environments {
  default {
    webdriver.base.url = "https://www.demoblaze.com"
  }
}
